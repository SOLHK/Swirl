if(NOT DEFINED SWIRL_LIBRARY OR NOT EXISTS "${SWIRL_LIBRARY}" OR IS_DIRECTORY "${SWIRL_LIBRARY}")
 message(FATAL_ERROR "Cargo did not produce the required Rust Core library: ${SWIRL_LIBRARY}")
endif()
foreach(program IN ITEMS SWIRL_BROKER SWIRL_HELPER)
 if(DEFINED ${program} AND NOT "${${program}}" STREQUAL "")
  if(NOT EXISTS "${${program}}" OR IS_DIRECTORY "${${program}}")
   message(FATAL_ERROR "Cargo did not produce the required product TUN executable: ${${program}}")
  endif()
  file(SIZE "${${program}}" size)
  if(size LESS 1024)
   message(FATAL_ERROR "The product TUN executable is empty or truncated: ${${program}}")
  endif()
 endif()
endforeach()
file(SIZE "${SWIRL_LIBRARY}" size)
if(size LESS 1024)
 message(FATAL_ERROR "The Rust Core library is empty or truncated: ${SWIRL_LIBRARY}")
endif()
